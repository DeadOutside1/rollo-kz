# ========================================================
# ROLLO.KZ - ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ========================================================

# 1. Telegram Bot (Серверные переменные для Vercel Functions)
# Создайте бота через @BotFather в Telegram и вставьте токен сюда:
TELEGRAM_BOT_TOKEN=

# Узнайте свой Chat ID через @userinfobot и вставьте сюда:
TELEGRAM_CHAT_ID=

# 2. Google Ads и Аналитика (Клиентские переменные с префиксом VITE_)
# Идентификатор Google Ads (например, AW-1234567890):
VITE_GOOGLE_ADS_ID=

# Ярлык конверсии для успешной отправки заявки (Conversion Label):
VITE_GOOGLE_ADS_LEAD_LABEL=

# Ярлык конверсии для клика по телефону (Call Label):
VITE_GOOGLE_ADS_CALL_LABEL=

# Ярлык конверсии для клика по WhatsApp (WhatsApp Label):
VITE_GOOGLE_ADS_WHATSAPP_LABEL=

# Идентификатор Google Analytics 4 (например, G-XXXXXXXXXX):
VITE_GA4_MEASUREMENT_ID=
